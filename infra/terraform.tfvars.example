aws_region                           = "ap-southeast-1"
project_name                         = "polyflash"
environment                          = "prod"
neon_database_pooled_url             = "postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
telegram_bot_token                   = "your_telegram_bot_token"
