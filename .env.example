# ==========================================
# CẤU HÌNH MÔI TRƯỜNG CHO HỆ THỐNG ĐẶT VÉ
# (DUAL-CORE NOSQL + SQL TICKETING SYSTEM)
# ==========================================

# 1. AWS CONFIGURATION
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
# Khi chạy local hoặc test (nếu cần credentials tĩnh):
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# 2. DYNAMODB CONFIGURATION
DYNAMODB_TABLE_SEATS=EventSeats
# Dùng cho local DynamoDB / LocalStack nếu chạy môi trường phát triển:
# DYNAMODB_ENDPOINT=http://localhost:8000

# 3. SQS FIFO CONFIGURATION
SQS_ORDER_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/ticketing-order-queue.fifo
SQS_ORDER_DLQ_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/ticketing-order-dlq.fifo

# 4. NEON SERVERLESS POSTGRESQL (SQL)
# Direct URL: Dùng cho việc chạy Migration cấu trúc bảng (bỏ qua connection pooler)
NEON_DATABASE_DIRECT_URL=postgresql://user:password@ep-sample-pooler-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Pooled URL: Dùng cho các Lambda Worker xử lý đơn hàng (thông qua PgBouncer pooler để tránh tràn kết nối)
NEON_DATABASE_POOLED_URL=postgresql://user:password@ep-sample-pooler-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 5. COGNITO & AUTHENTICATION (Tùy chọn cho API Gateway JWT Authorizer)
COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 6. APPLICATION BEHAVIOR & CONSTANTS
SEAT_HOLD_TTL_SECONDS=300
ORDER_PROCESSOR_MAX_BATCH_SIZE=10

# 7. CHATOPS & NOTIFICATIONS (TELEGRAM)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
